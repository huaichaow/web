{
  "name": "LoL Online",
  "short_name": "LoL Online",
  "description": "A mobile-browser MOBA: one lane, towers, minions and bots, played with a virtual joystick.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
